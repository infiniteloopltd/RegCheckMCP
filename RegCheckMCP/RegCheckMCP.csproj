<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Resources\secrets.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Login.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Login.html" />
    <EmbeddedResource Include="Resources\secrets.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
